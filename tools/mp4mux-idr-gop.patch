     SortSamples(left, (unsigned int)(array + n - left));
 }
 
+/* High@L3 DPB is 16 frames. Larger decode/display skew means POC is garbage
+   (avcut splice + mixed SPS). Then elst would delay video by GOP-length. */
+static const unsigned int AP4_MUX_MAX_COMPOSITION_DELAY = 16;
+
+static unsigned int
+ApplyCompositionTimestamps(AP4_SyntheticSampleTable* sample_table,
+                           AP4_Array<SampleOrder>& sample_orders)
+{
+    unsigned int max_delta = 0;
+    unsigned int count = sample_orders.ItemCount();
+    for (unsigned int i=0; i<count; i++) {
+        if (sample_orders[i].m_DecodeOrder > i) {
+            unsigned int delta = sample_orders[i].m_DecodeOrder - i;
+            if (delta > max_delta) {
+                max_delta = delta;
+            }
+        }
+    }
+    if (max_delta > AP4_MUX_MAX_COMPOSITION_DELAY) {
+        /* OTR-HQ hat 2 B-Frames. CTS=DTS lässt Quick Look/Decoder puffern. */
+        printf("mp4mux: composition delay %u frames (POC unusable, assume 2)\n", max_delta);
+        max_delta = 2;
+    }
+    for (unsigned int i=0; i<count; i++) {
+        sample_table->UseSample(sample_orders[i].m_DecodeOrder).SetCts(1000ULL*(AP4_UI64)(i+max_delta));
+    }
+    printf("mp4mux: composition delay %u frames\n", max_delta);
+    return max_delta;
+}
